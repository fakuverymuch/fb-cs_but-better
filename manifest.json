{
  "manifest_version": 3,
  "name": "67-CS",
  "version": "1.0",
  "description": "FB-CS But better",

  "permissions": ["storage", "tabs"],

  "host_permissions": [
    "*://*/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "*://*.fb-cs.ru/*",
        "*://fb-cs.ru/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://*/*"]
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "FBCS Settings"
  }
}